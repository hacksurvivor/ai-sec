{
  "name": "@codegrammer/ai-sec-cli",
  "version": "1.0.4",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-sec": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:local": "npm run build && npm pack --pack-destination ../../release"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.0",
    "chalk": "^5.6.2",
    "figlet": "^1.9.3",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
