PORT=8080
NODE_ENV=development
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=60
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_sec
MODEL_PROVIDER=mock
MODEL_TIMEOUT_MS=15000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
POLICY_PATH=./policy/policy.yaml
AUTH_MODE=required
SERVICE_API_TOKENS=replace-admin-token:admin,replace-analyst-token:analyst,replace-ingest-token:ingest

# Auth service (apps/auth-service)
AUTH_PORT=8090
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_ISSUER=ai-sec-auth-service
AUTH_AUDIENCE_DEFAULT=ai-sec-gateway
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
ACCESS_TOKEN_SECRET=replace-with-min-32-char-secret
REFRESH_TOKEN_PEPPER=replace-with-min-32-char-secret
PAIRWISE_SUBJECT_SECRET=replace-with-min-32-char-secret
PII_LOG_SALT=replace-with-min-32-char-secret
