{
  "env": {
    "AI_SEC_GATEWAY_URL": "http://127.0.0.1:8080",
    "AI_SEC_BEARER_TOKEN": "token-analyst",
    "AI_SEC_FAIL_CLOSED": "0"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/claude-ai-sec-hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/claude-ai-sec-hook.py\""
          }
        ]
      }
    ]
  }
}
